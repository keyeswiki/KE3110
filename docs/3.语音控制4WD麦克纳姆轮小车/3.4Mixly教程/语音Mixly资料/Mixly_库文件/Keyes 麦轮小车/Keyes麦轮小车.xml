<?xml version="1.0" encoding="UTF-8"?>
<xml type="company"
     block="block/Keyes.js"
     generator="generator/Keyes.js"
     language="language/Keyes/"
     lib="Keyes"
     hardware="hardware/arduino"
     media="media/keyesAll">

    <!-- Mixly3.0 JS脚本引入路径保持兼容 -->
    <script type="text/javascript" src="../../blocks/company/Keyes.js"></script>
    <script type="text/javascript" src="../../generators/arduino/company/Keyes.js"></script>

    <!-- 分类id必填，3.0侧边栏缓存依赖id区分 -->
    <category id="keyes_mecanum_car" name="麦轮小车" colour="20">
        <!-- 麦轮基础控制 -->
        <block type="Mecanum_led"></block>
        <block type="Mecanum_robot"></block>

        <!-- 超声波模块 -->
        <block type="ks4wd_sr04"></block>

        <!-- 舵机模块 -->
        <block type="ks4wd_servo2">
            <value name="angle">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>

        <!-- WS2812 RGB灯带系列 -->
        <block type="MAX_rgb_init">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="LEDCOUNT">
                <shadow type="math_number">
                    <field name="NUM">4</field>
                </shadow>
            </value>
        </block>
        <block type="MAX_rgb_brightness">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="NUM">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
        </block>
        <block type="MAX_rgb">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="_LED_">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
            <value name="RVALUE">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
            <value name="GVALUE">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
            <value name="BVALUE">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
        </block>
        <block type="MAX_rgb2">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="_LED_">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="MAX_rgb3">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="NUM">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
            <value name="WAIT">
                <shadow type="math_number">
                    <field name="NUM">20</field>
                </shadow>
            </value>
        </block>
        <block type="MAX_rgb4">
            <value name="PIN">
                <shadow type="pins_digital" />
            </value>
            <value name="NUM">
                <shadow type="math_number">
                    <field name="NUM">50</field>
                </shadow>
            </value>
            <value name="WAIT">
                <shadow type="math_number">
                    <field name="NUM">10</field>
                </shadow>
            </value>
        </block>

        <!-- 循迹传感器 -->
        <block type="ks4wd_track"></block>
        <!-- 红外接收 -->
        <block type="ks4wd_ir_r"></block>
        <!-- 蓝牙接收 -->
        <block type="ks4wd_bluetooth"></block>

        <!-- 系统内置串口读取块，无需修改 -->
        <block type="serial_readstr_until">
            <value name="CONTENT">
                <shadow type="text_char">
                    <field name="TEXT">#</field>
                </shadow>
            </value>
        </block>
    </category>
</xml>
